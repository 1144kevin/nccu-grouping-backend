APP_NAME=政缺一咖 API
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nccu_grouping
BACKEND_CORS_ORIGINS=["http://localhost:8081","http://127.0.0.1:8081","http://localhost:19006","http://localhost:7362"]

# Original login / grouping prototype. Local accounts only, no email verification.
CORE_LOCAL_ENABLED=false
CORE_LOCAL_DB_PATH=.local/core.sqlite3
CORE_SUPABASE_ENABLED=false

# Supabase credentials will be added after the project is created.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=post-media

# Server-side only. Never expose this value to the React Native app.
OPENAI_API_KEY=

# Stealth prototype: loopback-only, synthetic local users, disabled by default.
STEALTH_LOCAL_ENABLED=false
STEALTH_LOCAL_DB_PATH=.local/stealth.sqlite3
STEALTH_AI_PROVIDER=offline_rules
# Optional existing local Ollama only; never auto-download or use cloud models.
STEALTH_OLLAMA_MODEL=
STEALTH_OLLAMA_LOCAL_ONLY_CONFIRMED=false
STEALTH_SEMANTIC_ENABLED=false
STEALTH_EMBEDDING_MODEL=qwen3-embedding:0.6b

