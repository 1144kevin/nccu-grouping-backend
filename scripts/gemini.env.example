# Copy to .local/gemini.env and enter the key locally yourself.
# Do not put keys in EXPO_PUBLIC_* variables or commit .local/gemini.env.
# This selects Gemini only for the stealth conversation endpoint.
STEALTH_CONVERSATION_PROVIDER=gemini
STEALTH_GEMINI_MODEL=gemini-3.5-flash-lite
STEALTH_GEMINI_API_KEY=
