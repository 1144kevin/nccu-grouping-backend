# Copy privately to .local/cloud.env; fill actual HTTPS host, ingress networks and Publishable key.
# Then: python scripts/run_cloud_core.py --env-file .local/cloud.env (checks only).
ENVIRONMENT=cloud
CORE_CLOUD_ENABLED=true
CORE_SUPABASE_ENABLED=true
CORE_LOCAL_ENABLED=false
CORE_DEVICE_TEST_ENABLED=false
STEALTH_LOCAL_ENABLED=false
DEBUG=false
API_V1_PREFIX=/api/v1
CLOUD_PUBLIC_API_URL=https://replace-with-your-api.example/api/v1
# Exact immediate TLS gateway peers, NOT end-user IPs. No wildcard or default route.
CLOUD_PROXY_NETWORKS=["127.0.0.1/32"]
CLOUD_WORKERS=1
CLOUD_INSTANCES=1
CLOUD_BIND_HOST=127.0.0.1
PORT=8000
BACKEND_CORS_ORIGINS=[]
SUPABASE_URL=https://axdwbfhrkbovgrbngrrh.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace_with_sb_publishable_key
CORE_GOOGLE_IOS_ENABLED=false
# Native-only by default. Optional exact HTTPS /auth/callback with matching CORS origin.
CLOUD_GOOGLE_WEB_CALLBACK=
CORE_MEDIA_ENABLED=false
CORE_MEDIA_SIGNING_KEY=
STEALTH_AI_PROVIDER=offline_rules
CLOUD_AUTH_LIMIT=20
CLOUD_REQUEST_LIMIT=240
CLOUD_BODY_LIMIT=6291456
