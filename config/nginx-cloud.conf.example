# Illustrative single TLS ingress contract; not installed or started by this repository.
# Replace hostname/certificates and protect upstream port from direct internet access.
# This file belongs inside Nginx's http context; no process is started by this example.
map $uri $core_auth_key {
    default "";
    ~^/api/v1/auth/ $binary_remote_addr;
}
limit_req_zone $binary_remote_addr zone=core_requests:10m rate=4r/s;
limit_req_zone $core_auth_key zone=core_auth:10m rate=20r/m;
limit_req_status 429;
log_format core_safe '$request_method $status $upstream_http_x_request_id';
server {
    listen 443 ssl;
    server_name replace-with-your-api.example;
    ssl_certificate /private/tls/fullchain.pem;
    ssl_certificate_key /private/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 6m;
    client_body_timeout 30s;
    access_log /var/log/nginx/core-access.log core_safe;
    location / {
        limit_req zone=core_requests burst=20 nodelay;
        limit_req zone=core_auth burst=5 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host replace-with-your-api.example;
        proxy_set_header X-Forwarded-Host replace-with-your-api.example;
        proxy_set_header X-Forwarded-Proto https;
        # Overwrite, never append untrusted client-supplied forwarding headers.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header X-Real-IP "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 100s;
        proxy_send_timeout 30s;
    }
}
