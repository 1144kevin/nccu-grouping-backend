# Copy to .local/device-test.env. Never starts a listener until --serve is explicitly used.
# Exact RFC1918 addresses only; never 0.0.0.0, public IPs, CIDRs or wildcard clients.
DEVICE_HOST=192.168.1.10
DEVICE_CLIENTS=192.168.1.20
# Optional: authenticated intake/semantic through this TLS API, never direct Ollama.
# Requires confirmed local-only models in .local/local-ai.env. Default remains off.
DEVICE_AI_ENABLED=false
DEVICE_GOOGLE_IOS_CONFIRMED=false
# run_device_core only validates existing material. device_link prepare can issue local TLS.
# Only public ca.cer goes to Mac/iPhone; server private key stays Windows-only.
DEVICE_TLS_CERT=.local/tls/device-cert.pem
DEVICE_TLS_KEY=.local/tls/device-key.pem
DEVICE_TLS_CA=.local/tls/ca.pem
